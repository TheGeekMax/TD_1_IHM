<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="ensisa.birds.MainController">
    <center>
        <VBox fx:id="birdView" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
              prefWidth="600.0" spacing="5.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label fx:id="commonNameLabel" text="Name">
                            <font>
                                <Font name="Arial Black" size="24.0"/>
                            </font>
                        </Label>
                        <Label fx:id="latinNameLabel" text="Latin Name" textFill="#4d4d4d"/>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                    </padding>
                </VBox>
                <HBox minHeight="-Infinity" prefHeight="300.0" prefWidth="200.0">
                    <children>
                        <VBox prefWidth="200.0">
                            <children>
                                <Label fx:id="familyLabel" text="Fam name">
                                    <font>
                                        <Font name="Arial Unicode MS" size="13.0"/>
                                    </font>
                                </Label>
                                <Label fx:id="genusLabel" layoutX="10.0" layoutY="10.0" text="genus name">
                                    <font>
                                        <Font name="System Italic" size="13.0"/>
                                    </font>
                                </Label>
                                <Label fx:id="specieLabel" layoutX="10.0" layoutY="27.0" text="specie name">
                                    <font>
                                        <Font name="System Italic" size="13.0"/>
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <ImageView fx:id="birdImageView" fitHeight="300.0" pickOnBounds="true" preserveRatio="true"/>
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0"/>
                    </padding>
                </HBox>
                <Label fx:id="descriptionLabel" text="Descriptions" textAlignment="JUSTIFY" wrapText="true">
                    <padding>
                        <Insets left="20.0" right="20.0"/>
                    </padding>
                </Label>
            </children>
        </VBox>
    </center>
    <top>
        <ToolBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <items>
                <Button fx:id="editButton" mnemonicParsing="false" onAction="#editButtonAction" text="Editer"/>
                <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteButtonAction" text="Supprimer"/>
                <TextField promptText="Filtre" fx:id="filterTextField"/>
            </items>
        </ToolBar>
    </top>
    <left>
        <ListView fx:id="birdListView" prefWidth="200.0" BorderPane.alignment="CENTER"/>
    </left>
</BorderPane>
